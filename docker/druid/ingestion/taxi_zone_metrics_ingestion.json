{
  "type": "index_parallel",
  "spec": {
    "dataSchema": {
      "dataSource": "metricforge_taxi_zone_metrics",
      "timestampSpec": {
        "column": "pickup_date",
        "format": "auto"
      },
      "dimensionsSpec": {
        "dimensions": [
          "pickup_zone",
          "pickup_borough"
        ]
      },
      "metricsSpec": [
        {"type": "longSum", "name": "completed_trips", "fieldName": "completed_trips"},
        {"type": "doubleSum", "name": "gross_revenue", "fieldName": "gross_revenue"},
        {"type": "doubleSum", "name": "average_trip_duration", "fieldName": "average_trip_duration"},
        {"type": "doubleSum", "name": "average_trip_distance", "fieldName": "average_trip_distance"}
      ],
      "granularitySpec": {
        "segmentGranularity": "DAY",
        "queryGranularity": "DAY",
        "rollup": false
      }
    },
    "ioConfig": {
      "type": "index_parallel",
      "inputSource": {
        "type": "local",
        "baseDir": "/opt/metricforge/druid/input",
        "filter": "taxi_zone_metrics*.json"
      },
      "inputFormat": {
        "type": "json"
      }
    },
    "tuningConfig": {
      "type": "index_parallel"
    }
  }
}
