AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-postgres:5432/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True
METRICFORGE_API_URL=http://metricforge-api:8000
TRINO_HOST=trino
TRINO_PORT=8080
DRUID_BROKER_URL=http://druid:8888
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=metricforge
MINIO_SECRET_KEY=metricforge123
MINIO_RAW_BUCKET=metricforge-raw
MINIO_WAREHOUSE_BUCKET=metricforge-warehouse
MINIO_LOGS_BUCKET=metricforge-logs
MINIO_RAW_PREFIX=nyc_taxi
MINIO_SECURE=false
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=3g
SPARK_SQL_SHUFFLE_PARTITIONS=4
SPARK_WAREHOUSE_DIR=s3a://metricforge-warehouse/
SPARK_JARS_PACKAGES=
SPARK_EXTRA_JARS_DIR=/opt/spark-extra-jars
METRICFORGE_RUN_SPARK_IN_AIRFLOW=true
