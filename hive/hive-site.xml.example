<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <property>
    <name>hive.metastore.uris</name>
    <value>thrift://localhost:9083</value>
    <description>Metastore URI for local or VM-based deployments.</description>
  </property>

  <property>
    <name>hive.metastore.warehouse.dir</name>
    <value>/tmp/metricforge-nyc/warehouse</value>
    <description>Default warehouse directory for managed tables.</description>
  </property>

  <property>
    <name>javax.jdo.option.ConnectionURL</name>
    <value>jdbc:derby:;databaseName=/tmp/metricforge-nyc/metastore_db;create=true</value>
    <description>Simple embedded metastore backend for local experimentation.</description>
  </property>

  <property>
    <name>datanucleus.schema.autoCreateAll</name>
    <value>true</value>
    <description>Convenience setting for local demos only.</description>
  </property>
</configuration>
